# GhostESP board profile: ESP32 CYD 4.0 inch (E32R40T)
# ST7796 320x480 display + XPT2046 resistive touch.
# This file is merged onto the project's full ESP32 baseline by build.py.

CONFIG_BUILD_CONFIG_TEMPLATE="CYD 4.0 ST7796"
CONFIG_WITH_SCREEN=y
CONFIG_TFT_WIDTH=320
CONFIG_TFT_HEIGHT=480
CONFIG_USE_TOUCHSCREEN=y
CONFIG_USING_SPI=y
CONFIG_SD_SPI_CS_PIN=5
CONFIG_SD_SPI_CLK_PIN=18
CONFIG_SD_SPI_MISO_PIN=19
CONFIG_SD_SPI_MOSI_PIN=23

# LVGL display controller and geometry
CONFIG_LV_PREDEFINED_DISPLAY_NONE=y
CONFIG_LV_TFT_DISPLAY_CONTROLLER_ST7796S=y
# CONFIG_LV_TFT_DISPLAY_CONTROLLER_ST7735S is not set
CONFIG_LV_TFT_DISPLAY_USER_CONTROLLER_ST7796S=y
# CONFIG_LV_TFT_DISPLAY_USER_CONTROLLER_ST7735S is not set
CONFIG_LV_HOR_RES_MAX=320
CONFIG_LV_VER_RES_MAX=480
CONFIG_LV_DISPLAY_ORIENTATION_PORTRAIT=y
CONFIG_LV_TFT_DISPLAY_SPI2_HOST=y
CONFIG_LV_TFT_DISPLAY_SPI_TRANS_MODE_SIO=y
CONFIG_LV_TFT_DISPLAY_SPI_HALF_DUPLEX=y
CONFIG_LV_TFT_USE_CUSTOM_SPI_CLK_DIVIDER=y
CONFIG_LV_TFT_SPI_CLK_DIVIDER_2=y
CONFIG_LV_TFT_CUSTOM_SPI_CLK_DIVIDER=2

# CYD 4.0 TFT: MISO 12, MOSI 13, SCLK 14, CS 15, DC 2, no wired reset
CONFIG_LV_DISP_SPI_MOSI=13
CONFIG_LV_DISPLAY_USE_SPI_MISO=y
CONFIG_LV_DISP_SPI_MISO=12
CONFIG_LV_DISP_SPI_INPUT_DELAY_NS=0
CONFIG_LV_DISP_SPI_CLK=14
CONFIG_LV_DISPLAY_USE_SPI_CS=y
CONFIG_LV_DISP_SPI_CS=15
CONFIG_LV_DISPLAY_USE_DC=y
CONFIG_LV_DISP_PIN_DC=2
# CONFIG_LV_DISP_USE_RST is not set
CONFIG_LV_DISP_BACKLIGHT_SWITCH=y
CONFIG_LV_BACKLIGHT_ACTIVE_LVL=y
CONFIG_LV_DISP_PIN_BCKL=27

# XPT2046 touch shares the TFT SPI bus; CS is 33 and IRQ is 36
CONFIG_LV_TOUCH_CONTROLLER=1
CONFIG_LV_TOUCH_CONTROLLER_XPT2046=y
CONFIG_LV_TOUCH_DRIVER_PROTOCOL_SPI=y
CONFIG_LV_TOUCH_CONTROLLER_SPI3_HOST=y
CONFIG_LV_TOUCH_SPI_MISO=12
CONFIG_LV_TOUCH_SPI_MOSI=13
CONFIG_LV_TOUCH_SPI_CLK=14
CONFIG_LV_TOUCH_SPI_CS=33
CONFIG_LV_TOUCH_PIN_IRQ=36
# Raw calibration measured on the E32R40T portrait panel.
CONFIG_LV_TOUCH_X_MIN=227
CONFIG_LV_TOUCH_Y_MIN=285
CONFIG_LV_TOUCH_X_MAX=3618
CONFIG_LV_TOUCH_Y_MAX=3641
CONFIG_LV_TOUCH_XY_SWAP=y
CONFIG_LV_TOUCH_INVERT_X=y
# CONFIG_LV_TOUCH_INVERT_Y is not set
CONFIG_USE_BIT_BANG_TOUCH=y
CONFIG_LV_TOUCH_DETECT_IRQ_PRESSURE=y

# Keep the 4 MB ESP32 CYD within its internal RAM budget.
CONFIG_LV_MEM_SIZE_KILOBYTES=16
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=10

# CYD boards in this project use a 4 MB flash device.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
